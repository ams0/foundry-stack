name_prefix               = "openclaw"
location                  = "swedencentral"
enable_private_networking = false

# IP allowlist for AI Services / Foundry (empty = allow all)
allowed_ips = ["1.2.3.4"]

# OpenClaw can read secrets from extra_secrets via sensitive=true env entries.
# Example: pass an Anthropic API key the agent picks up from $ANTHROPIC_API_KEY.
openclaw_extra_secrets = {
  "anthropic-api-key" = "sk-ant-..."
}

openclaw_extra_env = [
  { name = "ANTHROPIC_API_KEY", value = "anthropic-api-key", sensitive = true }
]

# Set to false when running terraform destroy
prevent_deletion_if_contains_resources = true

tags = {
  Environment = "dev"
  Project     = "openclaw"
}
